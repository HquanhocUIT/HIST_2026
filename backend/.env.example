# Copy to backend/.env, or keep the existing workspace .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
# Set a private token for the team Sandbox. It stays on the server.
ADMIN_TOKEN=
# No public origins by default; Vite proxies /api to localhost:8000.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
